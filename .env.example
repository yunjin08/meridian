# Binance (Read Info only)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Finnhub
FINNHUB_API_KEY=

# Trading 212 (read scopes only)
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENV=live

# Anthropic (chat assistant)
ANTHROPIC_API_KEY=

# Chat market-data lookups. FRED is free: https://fred.stlouisfed.org/docs/api/api_key.html
# CoinGecko demo key is optional; it raises the keyless 30 req/min limit.
FRED_API_KEY=
COINGECKO_API_KEY=

# Dashboard auth: "salt:hex" scrypt hash and a random session secret
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Netlify Database (tax records, passkey credentials, alerts) needs no env var
# here — NETLIFY_DATABASE_URL is injected automatically per branch (production,
# deploy preview, or `netlify dev` locally). Schema lives in db/schema.ts.

# Resend (alert emails, sent by the alerts-cron scheduled function).
# Sender/recipient are hardcoded in utils/email.ts — single-user dashboard,
# not secrets.
RESEND_API_KEY=

# Passkey sign-in. A credential is bound to one origin, so localhost and
# production hold separate registrations.
#   local: WEBAUTHN_RP_ID=localhost, WEBAUTHN_ORIGIN=http://localhost:8888
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
